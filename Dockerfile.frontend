# syntax=docker/dockerfile:1
# The website: builds the React app, then serves the static files with nginx.
#
#   docker build -f Dockerfile.frontend \
#     --build-arg VITE_API_BASE_URL=https://vpsbackend.metawingsxr.com \
#     --build-arg VITE_SENTRY_DSN=... --build-arg VITE_POSTHOG_KEY=... \
#     -t vps-frontend .
#   docker run -p 8080:8080 vps-frontend
#
# VITE_* values are fixed at build time, so staging and production each need
# their own build of this image.

# ---- build ----
FROM node:22-slim AS build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@10.24.0 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

ARG VITE_API_BASE_URL
ARG VITE_SIMULATOR_URL
ARG VITE_ROOM_BASE_URL
ARG VITE_APP_ENV=production
ARG VITE_SENTRY_DSN
ARG VITE_POSTHOG_KEY
ARG VITE_POSTHOG_HOST

COPY . .
RUN pnpm build

# ---- serve ----
FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
