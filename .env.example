# Copy to .env and fill in. Empty monitoring keys = that service stays off.

# --- backend ---
MONGODB_URI=
JWT_SECRET=
APP_ENV=development

# AI: OpenRouter is the only AI provider (scenarios, patient, feedback,
# reasoning tutor). It is asked to route only to hosts that do not retain or
# train on prompts, and falls back across the listed models by itself.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-120b
# Optional: a faster model for the live patient only
OPENROUTER_SIM_MODEL=

# Sentry error tracking (backend)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# PostHog analytics (backend events, e.g. user_logged_in)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- website (baked in at build time) ---
VITE_API_BASE_URL=
VITE_SIMULATOR_URL=
VITE_APP_ENV=development
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
