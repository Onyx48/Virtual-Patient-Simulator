# Copy to .env (gitignored) and fill in. Loaded by dotenv from the process cwd,
# so the backend must be started from the repo root: `node backend/index.js`.

# ── Mode ───────────────────────────────────────────────────────────────────────
# development | production   (NODE_ENV is used as a fallback if APP_ENV is unset)
#   development: API error responses include the real reason; /debug/env is
#                exposed; any localhost / private-LAN origin passes CORS.
#   production:  clients get generic error wording, details go to the log only;
#                /debug/env is not registered; CORS is limited to the allowlist.
APP_ENV=development

# ── Required ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/your_db
JWT_SECRET=replace-me

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5001
# Extra browser origins allowed through CORS, comma-separated. Deployed
# frontends are already built in; use this for anything else.
# CORS_ORIGINS=https://example.com,http://localhost:4173

# ── Email (AWS SES) ────────────────────────────────────────────────────────────
# All four are required before any mail can be sent — welcome emails, password
# reset OTPs, and the school-admin invite / credential re-send on the Schools
# page. Without them those actions fail with HTTP 503.
# EMAIL_FROM must be an SES-verified identity.
AWS_REGION=ap-south-1
EMAIL_FROM=noreply@yourdomain.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── AI scenario authoring ──────────────────────────────────────────────────────
# Powers the "Ask AI" box on the scenario form (POST /api/scenarios/ai/generate
# and /ai/edit). Both keys are required; without them those two routes return
# HTTP 503 and the rest of the API is unaffected.
# GEMINI_API_KEY writes the patient scenario; VOXIO_API_KEY publishes it as a
# runnable conversation flow and is what mints each scenario's own apiKey.
GEMINI_API_KEY=
VOXIO_API_KEY=
# Overrides, rarely needed.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# VOXIO_BASE_URL=https://database.voxio.in

# ── Simulator handoff ──────────────────────────────────────────────────────────
# The simulator learns which scenario to run by polling GET /api/scenarios/json,
# which serves whichever scenario was published most recently — by an educator
# pressing Test or a student pressing Start. Last-write-wins: if two people start
# at once, both get the later one. Nothing is signed or encrypted, because
# nothing scenario-specific travels in the URL.
#
# Where students and educators are sent. Optional: falls back to
# VITE_SIMULATOR_URL at the bottom of this file, so normally you set only that.
# SIMULATOR_URL=https://share.streampixel.io/6a9bdb0a635d17b54874e623

# ── Session results (optional, nothing uses this today) ────────────────────────
# POST /api/sessions/complete exists for a simulator that wants to report a
# finished run back, authenticating with a JWE it was handed. Nothing calls it,
# and /api/sessions/start no longer mints a token, so this can stay empty — but
# until something does, transcripts, feedback and scores are never recorded and
# the dashboards that read them stay empty.
# JWE_SECRET must be base64 that decodes to exactly 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# JWE_SECRET=
# VOXIO_CHAT_BASE_URL=https://chat.voxio.in
# If the simulator posts the callback from a browser rather than server-side, add
# its origin to CORS_ORIGINS above. Server-to-server calls send no Origin and
# need no allowlisting.

# ── Redis (optional) ───────────────────────────────────────────────────────────
# Only used for password-reset OTP storage and login lockout. The server boots
# without it; those endpoints then refuse to issue OTPs.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
OTP_EXPIRY_SECONDS=300
MAX_OTP_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ── Frontend (build time, must be VITE_ prefixed) ──────────────────────────────
# Overrides the API base url baked into the bundle. Without it a production
# build targets https://vpsbackend.metawingsxr.com and a dev build targets
# http://localhost:5001.
# VITE_API_BASE_URL=http://localhost:5001

# Where the "Test" button on a scenario card sends the user — the hosted
# StreamPixel simulator. Change this when the simulator moves.
VITE_SIMULATOR_URL=https://share.streampixel.io/6a9bdb0a635d17b54874e623
