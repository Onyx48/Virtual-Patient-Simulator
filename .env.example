# Copy to .env and fill in. Empty monitoring keys = that service stays off.

# --- backend ---
MONGODB_URI=
JWT_SECRET=
APP_ENV=development
GEMINI_API_KEY=

# Simulator conversation (patient, feedback, reasoning tutor). Groq is used
# first when its key is set (same model Voxio ran: openai/gpt-oss-120b), Gemini
# otherwise; each is the other's fallback. A free Gemini key allows only
# 5 requests a minute, which is not enough for even one student.
GROQ_API_KEY=
SIM_LLM_PROVIDER=

# Sentry error tracking (backend)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# PostHog analytics (backend events, e.g. user_logged_in)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- website (baked in at build time) ---
VITE_API_BASE_URL=
VITE_SIMULATOR_URL=
VITE_APP_ENV=development
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
