# Copy to .env and fill in. Empty monitoring keys = that service stays off.

# --- backend ---
MONGODB_URI=
JWT_SECRET=
APP_ENV=development
GEMINI_API_KEY=

# OpenRouter: the primary AI provider when set, for the simulator and for
# scenario generation (model openai/gpt-oss-120b; override with OPENROUTER_MODEL).
# Gemini and Groq below are its fallbacks.
OPENROUTER_API_KEY=

# Simulator conversation (patient, feedback, reasoning tutor). Groq is used
# first when its key is set (same model Voxio ran: openai/gpt-oss-120b), Gemini
# otherwise; each is the other's fallback. A free Gemini key allows only
# 5 requests a minute, which is not enough for even one student.
GROQ_API_KEY=
SIM_LLM_PROVIDER=

# Sentry error tracking (backend)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# PostHog analytics (backend events, e.g. user_logged_in)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- website (baked in at build time) ---
VITE_API_BASE_URL=
VITE_SIMULATOR_URL=
VITE_APP_ENV=development
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ---- Voxio (voxio/* branches) -------------------------------------------
# Every scenario runs on its own Voxio flow, created and updated automatically
# when the scenario is saved (backend/utils/voxioSync.js). Existing scenarios:
#   node scripts/syncVoxioFlows.mjs            (dry run)
#   node scripts/syncVoxioFlows.mjs --apply
VOXIO_API_KEY=
# VOXIO_BASE_URL=https://database.voxio.in
# VOXIO_CHAT_BASE_URL=https://chat.voxio.in
# VOXIO_TIMEOUT_MS=90000
# VOXIO_GRADING_TIMEOUT_MS=120000
# Model for the conversation steps, and the small model that routes phases.
# VOXIO_LLM_SERVICE=groq
# VOXIO_LLM_MODEL=openai/gpt-oss-120b
# VOXIO_ROUTER_MODEL=openai/gpt-oss-20b
# VOXIO_PROCESS_TYPE=speech-native

# Webhook: Voxio posts session events here, so sessions that talk to Voxio
# directly (voice) still reach the dashboard. Needs a public HTTPS address.
PUBLIC_API_URL=
VOXIO_WEBHOOK_SECRET=

# Voice. Listening defaults to Soniox in the scenario's language. Speaking
# uses Voxio's default voice unless a voice is set per language and gender:
# VOXIO_TTS_SERVICE=elevenlabs
# VOXIO_TTS_MODEL=eleven_flash_v2_5
# VOXIO_TTS_VOICE_EN_MALE=
# VOXIO_TTS_VOICE_EN_FEMALE=
# VOXIO_TTS_VOICE_JA_MALE=
# VOXIO_TTS_VOICE_JA_FEMALE=
# Or a full setup as JSON, e.g. VOXIO_STT_JA={"service":"soniox","model":"stt-rt-v4","language":["ja"]}
#   VOXIO_STT_EN / VOXIO_STT_JA / VOXIO_TTS_EN_MALE / VOXIO_TTS_JA_FEMALE ...

# Talking-avatar faces for Voxio's own avatar widget (not needed by the Unreal
# 3D avatar, which reads `movement` and `expression` from each reply). JSON
# arrays of {uuid, label, usage}, labels from: neutral, pain, worried,
# frustrated, relieved, happy, confused.
# VOXIO_FACES_MALE=
# VOXIO_FACES_FEMALE=
# VOXIO_TRANSITIONS_MALE=
# VOXIO_TRANSITIONS_FEMALE=
VOXIO_USER_API_KEY=

# Educator Test button opens the Voxio room at this URL; leave empty to keep the old simulator
# Test opens our Voxio room. A path ("/room.html") opens on whatever origin the app runs on;
# a full URL only if the room is hosted elsewhere. Empty: Test uses the old simulator.
TEST_ROOM_URL=/room.html
# Patient room: dev shows what the flow sends (movements, frames, packets); prod hides it
VITE_ROOM_MODE=prod

# Where a student's Start goes. Set (e.g. /room.html): our Voxio WebRTC room, which reports results to
# POST /api/sessions/:id/room-results. Unset: the StreamPixel simulator (ROOM_BASE_URL).
STUDENT_ROOM_URL=
